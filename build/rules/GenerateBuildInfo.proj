<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- THIS PROJECT CANNOT BE LOADED INTO THE SOLUTION. -->
  <!--
    Generates TerminalBuildInfo.h: which commit this build came from, and when.

    The header carries a build timestamp, so regenerating it unconditionally
    would rewrite it on every build and recompile everything that includes it.
    Instead we cache the commit plus the porcelain status and key the header on
    that: the timestamp advances whenever the tree's content actually changes,
    and an unchanged tree rebuilds nothing. Same reasoning as the
    WriteOnlyWhenDifferent guard in GenerateFeatureFlags.proj.
  -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Any CPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Fuzzing|Any CPU">
      <Configuration>Fuzzing</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="AuditMode|Any CPU">
      <Configuration>AuditMode</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Any CPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>7b6f2c41-9a2e-4f0d-8c3b-5d1e6a9f4c88</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup>
    <IntermediateOutputPath>$(SolutionDir)obj\$(Configuration)\GenerateBuildInfo\</IntermediateOutputPath>
    <OpenConsoleCommonOutDir>$(SolutionDir)bin\$(Configuration)\</OpenConsoleCommonOutDir>

    <_WTBrandingName Condition="'$(WindowsTerminalBranding)'=='Canary'">Canary</_WTBrandingName>
    <_WTBrandingName Condition="'$(WindowsTerminalBranding)'=='Preview'">Preview</_WTBrandingName>
    <_WTBrandingName Condition="'$(WindowsTerminalBranding)'=='Release'">Release</_WTBrandingName>
    <_WTBrandingName Condition="'$(_WTBrandingName)'==''">Dev</_WTBrandingName>
  </PropertyGroup>

  <Target Name="_GenerateBuildInfoCache">
    <MakeDir Directories="$(IntermediateOutputPath)" />

    <Exec Command="git.exe rev-parse HEAD"
      CustomWarningRegularExpression="^fatal:.*"
      ConsoleToMsBuild="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildInfoCacheLines" />
    </Exec>

    <!-- Any uncommitted edit changes this listing, which advances the timestamp. -->
    <Exec Command="git.exe status --porcelain"
      CustomWarningRegularExpression="^fatal:.*"
      ConsoleToMsBuild="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildInfoCacheLines" />
    </Exec>

    <ItemGroup>
      <_BuildInfoCacheLines Include="$(_WTBrandingName)" />
    </ItemGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)build_info_cache.txt"
      Lines="@(_BuildInfoCacheLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)build_info_cache.txt" />
      <_BuildInfoCacheFiles Include="$(IntermediateOutputPath)build_info_cache.txt" />
    </ItemGroup>
  </Target>

  <Target Name="_RunBuildInfoScript"
    Inputs="@(_BuildInfoCacheFiles)"
    Outputs="$(OpenConsoleCommonOutDir)\inc\TerminalBuildInfo.h"
    DependsOnTargets="_GenerateBuildInfoCache">
    <MakeDir Directories="$(OpenConsoleCommonOutDir)\inc" />

    <!-- Escaped the same way as GenerateFeatureFlags.proj, to survive spaces in SolutionDir. -->
    <Exec
      Command="powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy ByPass -Command &quot;&amp;&apos;$(SolutionDir)\tools\Generate-BuildInfoHeader.ps1&apos; -Branding $(_WTBrandingName)&quot;"
      ConsoleToMsBuild="true"
      StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildInfoFileLines" />
    </Exec>

    <WriteLinesToFile File="$(OpenConsoleCommonOutDir)\inc\TerminalBuildInfo.h"
      Lines="@(_BuildInfoFileLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(OpenConsoleCommonOutDir)\inc\TerminalBuildInfo.h" />
    </ItemGroup>
  </Target>

  <Target Name="Build" DependsOnTargets="_RunBuildInfoScript" />
  <Target Name="Clean">
    <Delete Files="$(OpenConsoleCommonOutDir)\inc\TerminalBuildInfo.h" />
  </Target>
</Project>
