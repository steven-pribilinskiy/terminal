namespace TerminalApp
{
    [default_interface] runtimeclass TabRowControl : Windows.UI.Xaml.Controls.ContentPresenter,
                                                     Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TabRowControl();
        Microsoft.UI.Xaml.Controls.TabView TabView { get; };
        Boolean ShowElevationShield;
        Boolean ShowWorkspacesButton;
        String WorkspaceName;

        String SlotBadge { get; };
        Boolean ShowSlotBadge { get; };
        String SlotBadgeTooltipTitle { get; };
        String BuildCommit { get; };
        String BuildBranch { get; };
        String BuildTime { get; };

        Boolean PromotionAvailable;
        String PromotionDescription;
        event Windows.Foundation.TypedEventHandler<Object, Object> PromoteRequested;
    }
}
