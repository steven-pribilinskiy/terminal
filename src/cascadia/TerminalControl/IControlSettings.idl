import "IControlAppearance.idl";
import "EventArgs.idl";

namespace Microsoft.Terminal.Control
{
    enum ScrollbarState
    {
        Visible = 0,
        Hidden,
        Always
    };

    enum TextAntialiasingMode
    {
        Grayscale = 0,
        Cleartype,
        Aliased
    };

    enum PathTranslationStyle
    {
        None = 0,
        WSL,
        Cygwin,
        MSYS2,
        MinGW,
    };

    // Mirrors Microsoft.Terminal.Settings.Model.HyperlinkFileTypeGroup -- kept as a
    // separate, self-contained copy here (rather than importing the Settings Model
    // project's idl) because IControlSettings is otherwise a flat mirror with no
    // dependency on Settings Model WinRT types.
    enum HyperlinkFileTypeGroup
    {
        None = 0,
        Image,
        Video,
        Audio,
        Media,
        SourceCode,
        Document,
        Archive,
        Executable
    };

    // Mirrors Microsoft.Terminal.Settings.Model.HyperlinkTooltipAction. Icon is a
    // plain resolved (or raw) path string rather than an IMediaResource, since
    // IMediaResource is itself a Settings Model type.
    [default_interface] runtimeclass HyperlinkTooltipAction
    {
        HyperlinkTooltipAction();

        String Name;
        String ActionId;
        String Icon;
    }

    // Mirrors Microsoft.Terminal.Settings.Model.HyperlinkTooltipRule -- see that
    // type for the semantics of each field. TerminalSettings (the App-adapter
    // layer) is responsible for translating the Settings Model list into this one.
    // Mirrors Microsoft.Terminal.Settings.Model.HyperlinkMatchKind.
    enum HyperlinkMatchKind
    {
        Link = 0,
        Text
    };

    [default_interface] runtimeclass HyperlinkTooltipRule
    {
        HyperlinkTooltipRule();

        String Name;
        Boolean Enabled;
        HyperlinkMatchKind Kind;

        Windows.Foundation.Collections.IVector<String> Schemes;
        String Pattern;
        HyperlinkFileTypeGroup FileTypeGroup;
        Windows.Foundation.Collections.IVector<String> CustomExtensions;

        String Integration;
        Boolean ShowPreview;

        Windows.Foundation.IReference<Int32> TooltipShowDelay;
        Windows.Foundation.IReference<Int32> TooltipHideDelay;
        Windows.Foundation.IReference<Int32> TooltipMaxWidth;

        Boolean SuppressOpen;
        Boolean SuppressCopyLink;
        Boolean SuppressCopyPath;
        Boolean SuppressReveal;

        Windows.Foundation.Collections.IVector<HyperlinkTooltipAction> CustomActions;
    }

    // Class Description:
    // TerminalSettings encapsulates all settings that control the
    //      TermControl's behavior. In these settings there is both the entirety
    //      of the Core ITerminalSettings interface, and any additional settings
    //      for specifically the control.
    interface IControlSettings requires Microsoft.Terminal.Core.ICoreSettings,
                               Microsoft.Terminal.Control.IControlAppearance
    {
        Boolean EnableUnfocusedAcrylic { get; };
        Guid SessionId { get; };
        ScrollbarState ScrollState { get; };

        String FontFace { get; };
        Single FontSize { get; };
        Windows.UI.Text.FontWeight FontWeight { get; };
        String Padding { get; };
        Windows.Foundation.Collections.IMap<String, Single> FontFeatures { get; };
        Windows.Foundation.Collections.IMap<String, Single> FontAxes { get; };
        Boolean EnableBuiltinGlyphs { get; };
        Boolean EnableColorGlyphs { get; };
        String CellWidth { get; };
        String CellHeight { get; };

        Boolean CopyOnSelect { get; };
        Microsoft.Terminal.Control.CopyFormat CopyFormatting { get; };
        Boolean FocusFollowMouse { get; };
        Boolean ScrollToZoom { get; };
        Boolean OpenLinksOnSingleClick { get; };
        Int32 HyperlinkTooltipMaxWidth { get; };
        Int32 HyperlinkTooltipShowDelay { get; };
        Int32 HyperlinkTooltipHideDelay { get; };
        Boolean HyperlinkTooltipActions { get; };
        Windows.Foundation.Collections.IVector<HyperlinkTooltipRule> HyperlinkTooltipRules { get; };
        Boolean ScrollToChangeOpacity { get; };

        String Commandline { get; };
        String StartingDirectory { get; };

        TextAntialiasingMode AntialiasingMode { get; };

        // Experimental Settings
        Microsoft.Terminal.Control.GraphicsAPI GraphicsAPI { get; };
        Boolean DisablePartialInvalidation { get; };
        Boolean SoftwareRendering { get; };
        Microsoft.Terminal.Control.TextMeasurement TextMeasurement { get; };
        Microsoft.Terminal.Control.AmbiguousWidth AmbiguousWidth { get; };
        Microsoft.Terminal.Control.DefaultInputScope DefaultInputScope { get; };
        Boolean ShowMarks { get; };
        Boolean UseBackgroundImageForWindow { get; };
        Boolean RightClickContextMenu { get; };
        Boolean RepositionCursorWithMouse { get; };

        PathTranslationStyle PathTranslationStyle { get; };
        String DragDropDelimiter { get; };

        // NOTE! When adding something here, make sure to update ControlProperties.h too!
    };
}
