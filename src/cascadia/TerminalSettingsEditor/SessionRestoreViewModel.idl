import "EnumEntry.idl";

#include "ViewModelHelpers.idl.h"

namespace Microsoft.Terminal.Settings.Editor
{
    runtimeclass SessionRestoreViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        SessionRestoreViewModel(Microsoft.Terminal.Settings.Model.CascadiaSettings settings);

        // The same setting the Startup page shows, deliberately mirrored here.
        // It is this page's master switch: everything below is dead unless it is
        // set to restore something, which is what the two flags underneath report.
        IInspectable CurrentFirstWindowPreference;
        IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> FirstWindowPreferenceList { get; };
        // True unless the Terminal starts with a plain default-profile tab, i.e.
        // whenever anything is restored at all. Gates the resume settings.
        Boolean RestoreEnabled { get; };
        // True only when window *content* is restored too. Gates the saving settings.
        Boolean ContentEnabled { get; };

        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ResumeAgents);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ResumeMultiplexers);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, PersistBufferPeriodically);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, BufferPersistIntervalMinutes);

        String ResumeExtraProgramsText;
        String ResumeExcludedProgramsText;
        // Whether anything at all is eligible to be resumed, so the notice setting
        // can grey out when nothing would ever trigger it.
        Boolean AnyResumeEnabled { get; };

        IInspectable CurrentResumeSessionNotification;
        IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> ResumeSessionNotificationList { get; };

        String PersistCostSparkline { get; };
        String PersistCostSummary { get; };
    }
}
