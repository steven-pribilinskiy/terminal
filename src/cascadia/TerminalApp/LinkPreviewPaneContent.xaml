<UserControl x:Class="TerminalApp.LinkPreviewPaneContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Same value MarkdownPaneContent uses: SolidBackgroundFillColorTertiary.  -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackground">#282828</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackground">#F9F9F9</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="12,10"
          Background="{ThemeResource PageBackground}"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Which integration answered, and the two things you can do to the pane itself.  -->
        <Grid x:Name="PaneChromeHeader" Grid.Row="0"
              ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="HeaderIcon"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsTabStop="False" />
            <TextBlock x:Name="IntegrationName"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <!--  MinWidth/MinHeight are zeroed because the default style floors the ring above 16 px.  -->
            <mux:ProgressRing x:Name="LoadingRing"
                              Grid.Column="2"
                              Width="16"
                              Height="16"
                              MinWidth="0"
                              MinHeight="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsActive="False"
                              Visibility="Collapsed" />

            <Button x:Name="RefreshButton"
                    x:Uid="LinkPreviewRefreshButton"
                    Grid.Column="3"
                    Padding="6,2"
                    Click="_refreshClick">
                <FontIcon FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE72C;" />
            </Button>
            <Button x:Name="CloseButton"
                    x:Uid="LinkPreviewCloseButton"
                    Grid.Column="4"
                    Padding="6,2"
                    Click="_closeClick">
                <FontIcon FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <HyperlinkButton x:Name="SourceLink" Padding="0" HorizontalAlignment="Left">
                <TextBlock x:Name="SourceLinkText" TextWrapping="Wrap" />
            </HyperlinkButton>

            <!--
                The ticket and whatever it hangs off, the way Jira's own breadcrumb
                reads: AT-33 / AT-144, each with its work type's icon. Filled in by
                _render from the fields a manifest placed here, and empty for every
                integration that places none.
            -->
            <StackPanel x:Name="TicketBreadcrumbHost"
                        Orientation="Horizontal"
                        Spacing="4" />

            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
            </TextBlock>

            <!--
                The status badge belongs beside the dropdown that changes it and
                centred on that dropdown, which is why the form of required fields
                and the error line sit below this row rather than inside it:
                centring a badge against a column that grows walks it off the
                control it describes.
            -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel x:Name="TicketStatusHost" VerticalAlignment="Center" />
                <StackPanel x:Name="ActionRow"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                    <ComboBox x:Name="ActionOptions"
                              x:Uid="LinkPreviewActionOptions"
                              MinWidth="180"
                              SelectionChanged="_optionChanged" />
                    <Button x:Name="ApplyButton"
                            x:Uid="LinkPreviewApplyButton"
                            VerticalAlignment="Center"
                            Click="_applyClick" />
                    <Button x:Name="UndoButton"
                            x:Uid="LinkPreviewUndoButton"
                            VerticalAlignment="Center"
                            Click="_undoClick"
                            Visibility="Collapsed" />
                    <mux:ProgressRing x:Name="ActionProgress"
                                      Width="16"
                                      Height="16"
                                      MinWidth="0"
                                      MinHeight="0"
                                      VerticalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ActionFields"
                        Spacing="4"
                        Visibility="Collapsed" />

            <TextBlock x:Name="ActionError"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel x:Name="TicketMetadataHost" Orientation="Horizontal" Spacing="8" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel x:Name="TabStrip"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="2"
                    Visibility="Collapsed" />

        <ScrollViewer Grid.Row="4"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      IsTabStop="False"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <ContentControl x:Name="FilePreviewHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <StackPanel x:Name="FieldsHost"
                            Spacing="10" />
                <StackPanel x:Name="BodyHost"
                            Visibility="Collapsed" />
                <StackPanel x:Name="CommentsHost"
                            Spacing="10"
                            Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>



        <StackPanel Grid.Row="6" Spacing="8">
            <ToggleButton x:Name="PinLinkButton"
                          Content="Pin link"
                          HorizontalAlignment="Left"
                          ToolTipService.ToolTip="Keep this link. Other hovered links appear temporarily."
                          Click="_pinClick" />
            <ToggleSwitch x:Name="HideTooltipsSwitch"
                          x:Uid="LinkPreviewHideTooltipsSwitch"
                          Toggled="_hideTooltipsToggled" />
        </StackPanel>
    </Grid>
</UserControl>
