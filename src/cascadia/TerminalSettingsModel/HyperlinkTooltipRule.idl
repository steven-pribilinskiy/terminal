import "ISettingsModelObject.idl";

namespace Microsoft.Terminal.Settings.Model
{
    // Predefined groups of file extensions a rule can match a file:// (or bare
    // POSIX path) link against, in addition to (or instead of) an individual
    // extension list. Media is the union of Image, Video and Audio.
    enum HyperlinkFileTypeGroup
    {
        None = 0,
        Image,
        Video,
        Audio,
        Media,
        SourceCode,
        Document,
        Archive,
        Executable
    };

    // One custom button shown on the hyperlink tooltip card for links matched
    // by a HyperlinkTooltipRule. ActionId names an entry already defined under
    // "actions" -- the same reference-by-id scheme ActionEntry (New Tab Menu)
    // uses -- which is invoked with the hovered link's URI available to it.
    [default_interface] runtimeclass HyperlinkTooltipAction
    {
        HyperlinkTooltipAction();

        String Name;
        String ActionId;
        IMediaResource Icon;
    }

    // What a rule matches against. Link rules run against detected/OSC 8
    // hyperlinks; Text rules turn plain terminal text matching Pattern into a
    // hoverable, clickable match (an integration then resolves it to a link).
    enum HyperlinkMatchKind
    {
        Link = 0,
        Text
    };

    // When a pane shows its own title bar.
    enum PaneTitlebarVisibility
    {
        Never = 0,
        MultiplePanes,
        Always
    };

    // A rule that customizes the hyperlink tooltip card's behavior for links
    // matching its criteria. All set match criteria are ANDed together; an
    // unset criterion is skipped rather than treated as false. The first
    // enabled rule (in list order) whose criteria are all satisfied wins --
    // overrides are not merged across multiple matching rules.
    [default_interface] runtimeclass HyperlinkTooltipRule
    {
        HyperlinkTooltipRule();

        String Name;
        Boolean Enabled;
        HyperlinkMatchKind Kind;

        // --- match criteria ---
        IVector<String> Schemes;
        // Link rules: an ECMAScript regex searched in the link text.
        // Text rules: an ICU regex scanned over the terminal buffer; the whole
        // match becomes the hoverable text.
        String Pattern;
        HyperlinkFileTypeGroup FileTypeGroup;
        IVector<String> CustomExtensions;

        // --- preview ---
        // Which integration previews matches: "" = pick automatically by the
        // integrations' own matchers, "none" = no preview, else an integration id.
        String Integration;
        Boolean ShowPreview;

        // --- overrides; unset (null) means "inherit the global default" ---
        Windows.Foundation.IReference<Int32> TooltipShowDelay;
        Windows.Foundation.IReference<Int32> TooltipHideDelay;
        Windows.Foundation.IReference<Int32> TooltipMaxWidth;

        // --- built-in buttons ---
        // Which of "open", "copyLink", "copyPath", "reveal", "showInPane" this
        // rule's card carries. Empty inherits hyperlink.tooltipButtons.
        IVector<String> Buttons;
        // Unset inherits hyperlink.previewInPane.
        Windows.Foundation.IReference<Boolean> ShowInPane;

        IVector<HyperlinkTooltipAction> CustomActions;
    }
}
