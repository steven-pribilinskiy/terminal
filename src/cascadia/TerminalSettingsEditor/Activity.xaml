<Page x:Class="Microsoft.Terminal.Settings.Editor.Activity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One recorded event.

                System brushes only in here, and that is not a style preference.
                A custom key defined in a control's own ThemeDictionaries is not
                resolvable from inside a DataTemplate, and the failure is a
                process fail-fast (0xc000027b) whose stack blames measure rather
                than the template. The activity pane cost two build round trips
                learning that.
            -->
            <DataTemplate x:Key="ActivityItemTemplate"
                          x:DataType="local:ActivityEntryViewModel">
                <StackPanel Margin="0,6,0,10"
                            Spacing="2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ExeName}" />
                        <Border Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="3">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Kind}" />
                        </Border>
                        <TextBlock FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Timestamp}" />
                    </StackPanel>

                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Reason}"
                               TextWrapping="WrapWholeWords" />

                    <!--
                        The command line, monospaced because that is what it is,
                        and wrapped so the whole of it is visible at once. This
                        is the field you actually came for, so it is never
                        hidden behind a selection or an expander.
                    -->
                    <TextBlock Margin="0,2,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind CommandLine}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasCommandLine}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind WorkingDirectory}"
                                   Visibility="{x:Bind HasWorkingDirectory}" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ParentExe}"
                                   Visibility="{x:Bind HasParent}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Spacing="2"
                Style="{StaticResource SettingsStackStyle}">

        <!--
            Recording, and the cap that bounds the file. A master switch plus the
            one setting it gates is exactly the shape SettingsExpander exists
            for. IsForkFeature goes on the expander only, which forwards the mark
            to the card that draws its header. IsEnabled is repeated on the
            nested card rather than set on the expander, because setting it there
            would disable the header and make the toggle that gates it
            unclickable.
        -->
        <local:SettingsExpander x:Name="ActivityLog"
                                x:Uid="Globals_ActivityLog"
                                IsForkFeature="True">
            <local:SettingsExpander.Content>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ActivityLog, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            </local:SettingsExpander.Content>
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Name="ActivityLogMaxKilobytes"
                                    x:Uid="Globals_ActivityLogMaxKilobytes"
                                    IsEnabled="{x:Bind ViewModel.ActivityLog, Mode=OneWay}">
                    <muxc:NumberBox x:Uid="Globals_ActivityLogMaxKilobytesBox"
                                    Maximum="1048576"
                                    Minimum="64"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxSettingStyle}"
                                    Value="{x:Bind ViewModel.ActivityLogMaxKilobytes, Mode=TwoWay}" />
                </local:SettingsCard>
                <local:SettingsCard x:Name="ActivityLogPath"
                                    x:Uid="Globals_ActivityLogPath">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind ViewModel.LogPath, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <TextBlock x:Uid="Activity_RecordedHeader"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <local:SettingsCard x:Name="ActivityFilter"
                            x:Uid="Activity_Filter"
                            IsForkFeature="True">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBox x:Name="FilterBox"
                         x:Uid="Activity_FilterBox"
                         MinWidth="220"
                         Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Name="RefreshButton"
                        x:Uid="Activity_Refresh"
                        Click="RefreshButton_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="12"
                              Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </local:SettingsCard>

        <TextBlock Margin="4,8,4,4"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="WrapWholeWords" />

        <!--
            An ItemsControl, not a ListView, and no scroll viewer of its own: the
            page already scrolls, and a list that scrolls inside a page that
            scrolls is both awkward to use and the shape that left the Shortcuts
            page blank. The view model caps what it hands over, so realizing
            every row is bounded work.
        -->
        <Border Margin="0,4,0,0"
                Padding="12,4,12,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
            <ItemsControl ItemTemplate="{StaticResource ActivityItemTemplate}"
                          ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" />
        </Border>
    </StackPanel>
</Page>
