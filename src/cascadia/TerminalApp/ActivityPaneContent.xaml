<UserControl x:Class="TerminalApp.ActivityPaneContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             AutomationProperties.LocalizedControlType="pane"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--
                One recorded event. The headline is the program and when; the
                command line and folder are the part you actually came for, so
                they are always visible rather than hidden behind selection - a
                log you have to click through row by row is no faster than
                opening the file.
            -->
            <DataTemplate x:Key="ActivityItemTemplate"
                          x:DataType="local:ActivityEntry">
                <Grid Margin="0,4,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Program, kind and timestamp  -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ExeName}" />
                        <Border Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="3">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Kind}" />
                        </Border>
                        <TextBlock FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Timestamp}" />
                    </StackPanel>

                    <!--  Why it happened  -->
                    <TextBlock Grid.Row="1"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Reason}"
                               TextWrapping="WrapWholeWords" />

                    <!--
                        The command line, monospaced because that is what it is,
                        and wrapped so the whole of it is visible at once.
                    -->
                    <TextBlock Grid.Row="2"
                               Margin="0,4,0,0"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind CommandLine}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasCommandLine}" />

                    <!--  Folder and who started it  -->
                    <StackPanel Grid.Row="3"
                                Margin="0,2,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind WorkingDirectory}"
                                   Visibility="{x:Bind HasWorkingDirectory}" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ParentExe}"
                                   Visibility="{x:Bind HasParent}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!--
                Only PageBackground lives here, and only because it is used on
                the root Grid rather than inside the DataTemplate above.

                Everything the template draws with uses a system brush instead
                (TextFillColorSecondaryBrush, SubtleFillColorSecondaryBrush).
                That is not a style preference: a custom key defined in these
                ThemeDictionaries is NOT resolvable from inside a DataTemplate
                that a virtualizing panel instantiates. It fail-fasts the process
                with 0xc000027b, and the stack blames measure. The real frame is
                BinaryFormatObjectWriter::ProvideThemeResourceValue under
                CDataTemplate::QueryContentNoRef, i.e. the template could not be
                loaded at all because a ThemeResource in it did not resolve.

                SnippetsPaneContent looks like a counter-example and is not: its
                custom PlayButton* keys are referenced from a ControlTemplate
                inside a Style, never from its DataTemplate.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <!--  PageBackground matches SnippetsPaneContent, which matches MainPage.  -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackground">#282828</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackground">#F9F9F9</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Same shape as SnippetsPaneContent: TabFocusNavigation="Cycle" keeps tab focus inside the pane.  -->
    <Grid AllowFocusOnInteraction="False"
          AutomationProperties.AccessibilityView="Raw"
          Background="{ThemeResource PageBackground}"
          TabFocusNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="4"
              HorizontalAlignment="Stretch">
            <TextBlock x:Name="_title"
                       x:Uid="ActivityPaneTitle"
                       HorizontalAlignment="Left"
                       FontSize="24" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Uid="RefreshActivityPaneButton"
                        Click="_refreshClick">
                    <Button.Content>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE72C;" />
                    </Button.Content>
                </Button>
                <Button x:Uid="CloseActivityPaneButton"
                        Click="_closePaneClick">
                    <Button.Content>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE8BB;" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!--  How many entries, or why there are none.  -->
        <TextBlock Grid.Row="1"
                   Margin="8,0,8,8"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind StatusText, Mode=OneWay}"
                   TextWrapping="WrapWholeWords" />

        <TextBox x:Name="_filterBox"
                 x:Uid="ActivityFilterBox"
                 Grid.Row="2"
                 Margin="8,0,8,8"
                 AllowFocusOnInteraction="True"
                 TextChanged="_filterTextChanged">
            <TextBox.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBox.ContextFlyout>
        </TextBox>

        <ListView x:Name="_entryList"
                  Grid.Row="3"
                  AllowFocusOnInteraction="True"
                  ItemTemplate="{StaticResource ActivityItemTemplate}"
                  ItemsSource="{x:Bind Entries, Mode=OneWay}"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>

</UserControl>
