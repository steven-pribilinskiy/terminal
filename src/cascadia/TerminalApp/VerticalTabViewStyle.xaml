<!--
    The tab strip, rotated into a column, for theme.window.tabPosition of "left"
    or "right". TerminalPage::_ApplyTabPosition assigns VerticalTabViewStyle to
    the TabView when it builds one of those layouts, and clears it again when it
    doesn't - see _ResetRootGridLayout.

    Why re-template rather than build a tab strip out of a ListView: everything
    the WinUI control already does keeps working. Drag to reorder, drag out to
    tear a tab into its own window, keyboard cycling, the automation tree screen
    readers walk, tooltips, and the ~40 TabViewItemHeader* resource keys that
    Tab::_ApplyTabColorOnUIThread overwrites per tab. Hand-rolling that list was
    tried first and is the reason this file is markup instead of code.

    The individual TabViewItem keeps its stock template deliberately. Its
    FrameworkElement.HorizontalAlignment already defaults to Stretch, so inside a
    vertically-oriented ItemsStackPanel each tab fills the column on its own. The
    one thing that would break that is MUX writing an explicit Width onto every
    item, which TabView::UpdateTabWidths does for the Equal and Compact width
    modes - so TerminalPage::_UpdateTabWidthMode pins SizeToContent while the
    strip is vertical, and no item style is needed here at all.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:local="using:TerminalApp"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
                    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
                    mc:Ignorable="d">

    <!--
        The TabView itself. The stock template lays TabContainerGrid out as four
        columns - header, tabs, add button, footer - so this is the same four
        slots turned into rows.

        Every x:Name below is load-bearing: TabView's compiled code-behind looks
        these parts up by name in OnApplyTemplate and will fail or silently stop
        working if one goes missing. That is why LeftBottomBorderLine and
        RightBottomBorderLine survive here despite a vertical strip having no
        bottom border to draw - the SingleBottomBorderLine visual state below
        still targets them by name.
    -->
    <Style x:Key="VerticalTabViewStyle"
           TargetType="mux:TabView">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{ThemeResource TabViewHeaderPadding}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource TabViewBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="mux:TabView">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  The strip takes the height; the content presenter is unused here.  -->
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="NormalBottomBorderLine" />
                                <VisualState x:Name="SingleBottomBorderLine">
                                    <VisualState.Setters>
                                        <Setter Target="LeftBottomBorderLine.(Grid.RowSpan)" Value="4" />
                                        <Setter Target="RightBottomBorderLine.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="TabContainerGrid"
                              Background="{TemplateBinding Background}"
                              XYFocusKeyboardNavigation="Enabled">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="LeftContentColumn" Height="Auto" />
                                <RowDefinition x:Name="TabColumn" Height="*" />
                                <RowDefinition x:Name="AddButtonColumn" Height="Auto" />
                                <RowDefinition x:Name="RightContentColumn" Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Kept for the named-part lookup and the visual state above.
                                Collapsed because the horizontal rule they draw under a
                                top strip has no meaning beside a vertical one.
                            -->
                            <Border x:Name="LeftBottomBorderLine"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    BorderBrush="{ThemeResource TabViewBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed" />
                            <Border x:Name="RightBottomBorderLine"
                                    Grid.Row="2"
                                    Grid.RowSpan="2"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    BorderBrush="{ThemeResource TabViewBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed" />

                            <ContentPresenter x:Name="LeftContentPresenter"
                                              Grid.Row="0"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding TabStripHeader}"
                                              ContentTemplate="{TemplateBinding TabStripHeaderTemplate}" />

                            <!--
                                Deliberately NOT given a Style. An explicit Style
                                replaces the implicit one outright rather than
                                layering on it, and the implicit
                                primitives:TabViewListView style is where the
                                control's Template lives - a ScrollViewer around
                                an ItemsPresenter. A style that set the items
                                panel but no Template left this list with no
                                visual tree at all, which XAML accepted and then
                                failed to render: E_FAIL out of
                                CCoreServices::NWDrawTree, on the tick *after*
                                the layout was built, so it presented as an
                                unexplained fail-fast rather than as a bad style.

                                Setting the panel as a local value on the element
                                keeps the implicit style, its Template and
                                App.xaml's ItemContainerTransitions override, and
                                changes only the one thing that has to change.
                            -->
                            <primitives:TabViewListView x:Name="TabListView"
                                                        Grid.Row="1"
                                                        Padding="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        AllowDrop="{TemplateBinding AllowDropTabs}"
                                                        CanDragItems="{TemplateBinding CanDragTabs}"
                                                        CanReorderItems="{TemplateBinding CanReorderTabs}"
                                                        ItemTemplate="{TemplateBinding TabItemTemplate}"
                                                        ItemTemplateSelector="{TemplateBinding TabItemTemplateSelector}"
                                                        ItemsSource="{TemplateBinding TabItemsSource}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                        ScrollViewer.VerticalScrollMode="Enabled">
                                <primitives:TabViewListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </primitives:TabViewListView.ItemsPanel>
                            </primitives:TabViewListView>

                            <Border Grid.Row="2"
                                    Padding="{ThemeResource TabViewItemAddButtonContainerPadding}"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsAddTabButtonVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                <Button x:Name="AddButton"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{TemplateBinding AddTabButtonCommand}"
                                        CommandParameter="{TemplateBinding AddTabButtonCommandParameter}"
                                        Content="&#xE710;"
                                        HighContrastAdjustment="None"
                                        IsTextScaleFactorEnabled="False"
                                        Style="{ThemeResource TabViewButtonStyle}" />
                            </Border>

                            <ContentPresenter x:Name="RightContentPresenter"
                                              Grid.Row="3"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding TabStripFooter}"
                                              ContentTemplate="{TemplateBinding TabStripFooterTemplate}" />
                        </Grid>

                        <ContentPresenter x:Name="TabContentPresenter"
                                          Grid.Row="1"
                                          Background="{ThemeResource TabViewItemHeaderBackgroundSelected}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
